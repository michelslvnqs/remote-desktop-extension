{
  "manifest_version": 3,
  "name": "Remote Desktop Code Generator",
  "version": "1.1.0",
  "description": "Gera códigos de suporte remoto no Google Remote Desktop e salva na planilha",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://remotedesktop.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://remotedesktop.google.com/support*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gerar Código Remote Desktop"
  }
}
